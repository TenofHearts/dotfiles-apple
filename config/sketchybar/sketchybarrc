#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar position=top blur_radius=30 color=0x40000000 \
  --default padding_left=5 padding_right=5 \
  icon.font="Hack Nerd Font:Bold:14.0" label.font="Hack Nerd Font:Bold:12.0" \
  icon.color=0xffffffff label.color=0xffffffff \
  icon.padding_left=4 icon.padding_right=4 label.padding_left=4 label.padding_right=4

sketchybar --add event aerospace_workspace_change

sketchybar --add item aerospace.mode left \
  --set aerospace.mode icon.drawing=off label="…" label.font="Hack Nerd Font:Bold:11.0" \
  script="/bin/bash \"$PLUGIN_DIR/aerospace-mode.sh\"" \
  --subscribe aerospace.mode display_change system_woke \
  --add item aerospace.refresh left \
  --set aerospace.refresh drawing=off update_freq=0 \
  script="python3 \"$PLUGIN_DIR/status.py\" aerospace" \
  --subscribe aerospace.refresh aerospace_workspace_change display_change system_woke \
  --add item bar.height left \
  --set bar.height drawing=off script="\"$PLUGIN_DIR/height.sh\"" \
  --subscribe bar.height display_change system_woke

sketchybar --add item front_app left \
  --set front_app icon.drawing=off label.font="SF Pro:Semibold:12.0" \
  label.max_chars=28 padding_left=12 script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched system_woke

# Right items are added from the outer edge inward.
# Visual order: volume, network, Bluetooth, battery, date.
sketchybar --add item clock right \
  --set clock update_freq=10 icon= script="$PLUGIN_DIR/clock.sh" \
  --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change \
  --add item bluetooth right \
  --set bluetooth icon= update_freq=15 \
  script="python3 \"$PLUGIN_DIR/status.py\" bluetooth" \
  --subscribe bluetooth system_woke \
  --add item network right \
  --set network icon=󰖩 update_freq=15 \
  script="python3 \"$PLUGIN_DIR/status.py\" network" \
  --subscribe network wifi_change system_woke \
  --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

"$PLUGIN_DIR/height.sh"
sketchybar --update
