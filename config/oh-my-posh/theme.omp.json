{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╭",
          "foreground": "#6c7086"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "always",
            "fetch_version": true,
            "fetch_virtual_env": true,
            "home_enabled": true,
            "postfix": " ",
            "prefix": " ",
            "display_default": true
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "   {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}  ",
          "foreground": "#1e1e2e",
          "background": "#89b4fa",
          "type": "python",
          "style": "diamond"
        },
        {
          "background": "#94e2d5",
          "foreground": "#1e1e2e",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f2cdcd{{ end }}",
            "{{ if gt .Ahead 0 }}#b4befe{{ end }}",
            "{{ if gt .Behind 0 }}#eba0ac{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "commit_icon": " "
          },
          "style": "diamond",
          "template": " on {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}   {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "trailing_diamond": "",
          "type": "git"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none",
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} ",
          "foreground": "#1e1e2e",
          "trailing_diamond": "",
          "background": "#cba6f7",
          "type": "executiontime",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "├",
          "foreground": "#6c7086"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "template": " Hi, {{ .UserName }} ",
          "foreground": "#1e1e2e",
          "trailing_diamond": "",
          "background": "#f5c2e7",
          "type": "session",
          "style": "diamond"
        },
        {
          "type": "battery",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "#1e1e2e",
          "background": "#fab387",
          "template": " Battery: {{ if not .Error }}{{ .Icon }} {{ .Percentage }}{{ end }}  ",
          "properties": {
            "discharging_icon": " ",
            "charging_icon": " ",
            "charged_icon": " "
          }
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "…",
            "folder_separator_icon": " <#45475a></> ",
            "max_depth": 2,
            "style": "agnoster_short"
          },
          "template": "  {{ .Path }} ",
          "foreground": "#1e1e2e",
          "trailing_diamond": "",
          "background": "#f9e2af",
          "type": "path",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╰",
          "foreground": "#6c7086"
        },
        {
          "properties": {
            "alpine": "",
            "arch": "",
            "cache_duration": "none",
            "centos": "",
            "debian": "",
            "elementary": "",
            "fedora": "",
            "gentoo": "",
            "linux": "",
            "macos": "",
            "manjaro": "",
            "mint": "",
            "opensuse": "",
            "raspbian": "",
            "ubuntu": "",
            "windows": ""
          },
          "template": " {{ .Icon }} {{ if .Root }}#{{else}}❯{{end}} ",
          "foreground": "#1e1e2e",
          "background": "#a6e3a1",
          "leading_diamond": "",
          "trailing_diamond": "",
          "type": "os",
          "style": "diamond"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
