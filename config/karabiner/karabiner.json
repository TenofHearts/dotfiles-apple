                                    "key_code": "l",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "q",
                                        "modifiers": ["left_control", "left_command"]
                                    }
                                ],
                                "type": "basic"
