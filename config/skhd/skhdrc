# Left Option after Karabiner remapping. One selector routes both WMs.
# Include Homebrew prefixes for launchd and the shared shell dispatcher.

lalt - h : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" focus left
lalt - j : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" focus down
lalt - k : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" focus up
lalt - l : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" focus right
lalt - m : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH skhd -k "cmd - m"
lalt - q : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" close
lalt - 1 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 1
lalt - 2 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 2
lalt - 3 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 3
lalt - 4 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 4
lalt - 5 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 5
lalt - 6 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 6
lalt - 7 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 7
lalt - 8 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 8
lalt - 9 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" workspace 9
lalt + shift - 0x29 : PATH=/opt/homebrew/bin:/usr/local/bin:$PATH "$HOME/.config/window-manager/hotkey.sh" command
