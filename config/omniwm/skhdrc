# Visual features in Main; existing modal keys retain their behavior.
# Overview is disabled: its search bar overlaps the camera notch in 0.7.6.
default, help, reload, pause < lalt - 0x32 : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" quake
