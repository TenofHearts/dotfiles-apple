# Left Option is received after Karabiner remapping.
# Native OmniWM hotkeys are disabled in settings.toml.

# Entry actions never synthesize keys. Action modes have complete Main bindings.
# Pass the callback shell PID so delayed callbacks cannot overwrite a newer mode.
:: default : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter main "$$"
:: command @ : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter command "$$"
:: move @ : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter move "$$"
:: adjust @ : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter adjust "$$"
:: admin @ : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter admin "$$"
:: help : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter main "$$" help
:: reload : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter main "$$" reload
:: pause : "${XDG_CONFIG_HOME:-$HOME/.config}/wm/wm.sh" enter main "$$" pause
default, command, move, adjust, admin, help, reload, pause < lalt - escape ; default
# Option-Escape also works while Shift is held.
default, command, move, adjust, admin, help, reload, pause < lalt + shift - escape ; default
# Keep repeated focus keys on the native CLI path in every mode. Exec avoids
# another shell, backend lookup, and wrapper process on each keypress.
default, command, move, adjust, admin, help, reload, pause < lalt - h : exec "${DOTFILES_OMNIWMCTL:-/Applications/OmniWM.app/Contents/MacOS/omniwmctl}" command focus left
default, command, move, adjust, admin, help, reload, pause < lalt - j : exec "${DOTFILES_OMNIWMCTL:-/Applications/OmniWM.app/Contents/MacOS/omniwmctl}" command focus down
default, command, move, adjust, admin, help, reload, pause < lalt - k : exec "${DOTFILES_OMNIWMCTL:-/Applications/OmniWM.app/Contents/MacOS/omniwmctl}" command focus up
default, command, move, adjust, admin, help, reload, pause < lalt - l : exec "${DOTFILES_OMNIWMCTL:-/Applications/OmniWM.app/Contents/MacOS/omniwmctl}" command focus right
